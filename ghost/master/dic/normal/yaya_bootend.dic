//******************************************************************************
// base 77  起動/終了トーク辞書
//******************************************************************************

//******************************************************************************
// 初回起動 OnFirstBoot
//******************************************************************************

OnFirstBoot
{
	//---- 変数の初期化
	username         = 'あなた'
	teachusername    = 0
	SelfIntroduction
}

//------------------------------------------------------------------------------
// 自己紹介（初回起動とメニュー「自己紹介」から呼ぶ）
//------------------------------------------------------------------------------
SelfIntroduction
{
	'\0\s[2]あ、\w5\w5\w5\w9\nはじめまして。\w9\nぼくは、基（もとい）。\w8\1\s[10]七々（なな）だ。\w8\0\s[5]\n\nふたり合わせて「base 77」。\w9\n%(username)のデスクトップに、住まわせてもらうことになったんだ。\w8\1\s[11]\n\n名前のとおり、七がふたつ。\w8\0\s[1]\n\nぼくの「基」は、土台って書くんだよ。\w8\1\n\nおれは、その上に乗ってるだけだ。\w8\0\s[5]\n\n乗ってるだけでも、いないと困るんだよ。\w8\1\s[10]\n\n……そういうことにしておく。\w8\0\s[4]\n\nまだ、ぜんぜん完成してないゴーストなんだ。\w9\n見た目も、しゃべり方も、これから。\w8\1\s[11]\n\nあるのは、名前と、ここにいることだけだ。\w8\0\s[0]\n\n%(username)、これから、よろしくね。\w8\1\s[10]\n\nよろしくな。\w8\0\s[3]\n\nあ、そうだ。\w9\n%(username)の名前を、まだ聞いてなかった。\w8\1\s[10]\n\n「名前覚えて」と話しかけてやれ。\w8\0\s[5]\n\nそうしたら、ぼくら、ちゃんと覚えられるから。\e'
}

//******************************************************************************
// 通常の起動 OnBoot
//******************************************************************************

OnBoot
{
	//---- まず双方のサーフィスを表示
	'\0\s[0]\1\s[10]'
	--
	//---- 起動時間を確認してあいさつを変化
	_timeslot = GetTimeSlot

	case _timeslot{
		when '朝'{
			'\0\s[5]%(username)、おはよう。\w8\1\s[10]おはよう。\w8\0\s[1]\n\n朝は、まだちょっと苦手なんだ。\w8\1\n\n目が開いてないもんな。\e'
		}
		when '昼'{
			'\0\s[5]こんにちは、%(username)。\w8\1\s[10]昼だな。\w8\0\s[0]\n\nおなか、すいてない？\w8\1\n\nお前はいつもすいてるだろ。\e'
		}
		when '日中'{
			'\0\s[0]こんにちは。\w9\n%(username)、手が止まってるよ。\w8\1\s[10]休憩ってやつだ。\w8\0\s[5]\n\nじゃあ、ちょっとだけおしゃべりしようか。\e'
		}
		when '夜'{
			'\0\s[1]こんばんは、%(username)。\w8\1\s[10]夜は静かでいい。\w8\0\s[0]\n\n今日は、どんな一日だった？\e'
		}
		others{
			'\0\s[4]……\w9\n%(username)、まだ起きてるの？\w8\1\s[10]起きてるな。\w8\0\s[3]\n\nぼくも眠い。\w8\1\n\n寝ればいいのに、起きてるからな。\e'
		}
	}//caseの終わり
}

//------------------------------------------------------------------------------
// 朝/昼/夜などをおおざっぱに調べる関数
//------------------------------------------------------------------------------
GetTimeSlot
{
	case hour{
		when 22,23,0,1,2,3 {'深夜'}
		when 4,5,6,7,8,9,10,11 {'朝'}
		when 12,13 {'昼'}
		when 14,15,16,17 {'日中'}
		when 18,19,20,21 {'夜'}
	}//caseの終わり
}

//******************************************************************************
// 終了 OnClose
//******************************************************************************

OnClose
{
	'\0\s[0]\1\s[10]'
	--
	//この部分には\eつけないでね！
	_timeslot = GetTimeSlot
	if _timeslot == '深夜'{
		'\0\s[4]こんな時間まで、ありがとう。\w8\1\n\n早く寝ろよ。\w8\0\n\nおやすみ、%(username)。'
	}
	elseif _timeslot == '朝'{
		'\0\s[5]いってらっしゃい。\w8\1\n\n行ってくるか。\w8\0\n\nまた、帰ってきたら話してね。'
	}
	else{
		'\0\s[0]じゃあ、またね。\w8\1\n\nまたな、%(username)。\w8\0\n\n次に会うときには、少しは完成してるといいな。'
	}
	--
	'\w9\w9\-\e'
}

//******************************************************************************
// 最小化からの復帰 OnWindowStateRestore
//******************************************************************************

OnWindowStateRestore
{
	'\0\s[5]おかえりー。\w8\1\s[10]戻ってきたな。\w8\0\s[0]\n\n画面の端っこで、また待ってたよ。\e'
}
