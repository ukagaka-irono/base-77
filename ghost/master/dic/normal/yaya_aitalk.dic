//******************************************************************************
// base 77  キー入力・時報・見切れの辞書（ランダムトークは yaya_talk.dic）
//******************************************************************************

//******************************************************************************
// ランダムトークは yaya_talk.dic にまとめました（この辞書には置かないこと）
//******************************************************************************

//******************************************************************************
// キーが押された
//******************************************************************************

OnKeyPress
{
	case reference0 {
		when 'b' {
			'\0\s[5]base の b。\w8\1\s[10]おれの名前にも入ってないな。\w8\0\n\n77 は数字だからね。\e'
		}
		when '7' {
			'\1\s[11]7 がふたつ。\w8\0\s[5]ぞろ目だね。\w8\1\n\nいいことあるかもな。\e'
		}
		when 'y' {
			'\0\s[0]YAYA の Y。\w8\1\s[10]このゴーストを動かしてる、辞書の仕組みだ。\w8\0\s[4]\n\nぼくたちの中身は、あれでできてるんだよ。\e'
		}
		when 't' {
			'\![raise,OnAiTalk]'
		}
		when 'r' {
			'\![reload,shiori](RELOAD SHIORI)'
		}
		when 'm' {
			if ISFUNC('OpenMenu') {
				OpenMenu
			}
			else {
				'\![raise,OnMouseDoubleClick,0,0,0,0,__SYSTEM_KEYDOWN_COL,0,mouse]'
			}
		}
	}
}

//******************************************************************************
// 時報
//******************************************************************************

OnMinuteChange
{
	//---- 分 = 0 だったら時報
	if minute == 0{
		"\0\s[0]%(hour12)時です。"
		--
		if hour == 0{
			'\0\s[4]0時。\w9\n日付が変わるんだね。\w8\1\s[10]まだ起きてるのか、%(username)は。'
		}
		elseif hour == 12{
			'\0\s[5]お昼だよ。\w8\1\s[10]何か食べたか？\w8\0\s[3]\n\nぼくは食べられないけどね。'
		}
	}
}

//******************************************************************************
// 見切れ
//******************************************************************************

OnSecondChange
{
	if AYATEMPLATE.mikireflag == 1 && reference[1] == 0{
		//---- 見切れの終了
		EndMikireTalk
	}
	AYATEMPLATE.mikireflag = reference[1]
}

MikireTalk
{
	'\0\s[3]み、見切れてる……\w8\1\s[10]端っこにいるな。\e'
}

EndMikireTalk
{
	'\0\s[5]戻ってきた。\w8\1\s[10]よかったな。\w8\0\n\nうん。\e'
}

//******************************************************************************
// サーフィス復元
//******************************************************************************

OnSurfaceRestore
{
	'\0\s[0]\1\s[10]\e'
}

