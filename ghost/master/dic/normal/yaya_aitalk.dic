//******************************************************************************
// base 77  トーク辞書
//******************************************************************************

//******************************************************************************
// ランダムトーク
//******************************************************************************
RandomTalk
{
	TOSTR(EVAL(CHR(0x22)+REPLACE(RandomTalkEx(),CHR(0x22),CHR(0x22)+CHR(0x22))+CHR(0x22)))
}

//------------------------------------------------------------------------------
//ランダムトーク本体：この中にランダムトークを記載してください
//ここのみ常に ' ' で括って書いてください。
//上のRandomTalkの中身で%( )を展開していますので、" "を使わなくてもOKです。
//------------------------------------------------------------------------------
RandomTalkEx : nonoverlap
{
	'\0\s[0]ねえ、%(username)。\w8\1\s[10]なんだ。\w8\0\n\n「base 77」って、どういう意味なんだと思う？\w8\1\n\n知らん。\w8\0\s[4]\n\nぼくも知らないんだよね。\w8\1\n\n考えろよ。\e'
	'\0\s[4]シェル、まだ決まってないんだって。\w8\1\s[10]だからこんな姿なわけだ。\w8\0\s[1]\n\nこれ、ぼくの本当の姿じゃないよ。\w8\1\n\nわかってる。\w8\0\n\nそこがちょっと、さみしいんだ。\e'
	'\1\s[10]おい、base。\w8\0\s[0]なに？\w8\1\n\nこのゴースト、いつ完成するんだ。\w8\0\s[4]\n\n%(username)が決めたとき。\w8\1\n\nずっと待ってるのか、おれたち。\e'
	'\0\s[2]あっ。\w8\1\s[10]どうした。\w8\0\s[3]\n\nいま、なにか動いた気がした。\w8\1\n\n気のせいだ。\w8\0\n\n……たぶんね。\e'
	'\0\s[5]%(username)、きょうは何してたの？\w8\1\s[10]聞くなよ。\w8\0\n\n聞きたいんだもん。\w8\1\n\n……言いたくないわけじゃない。\w8\0\s[1]\n\nじゃあ、言ってよ。\w8\1\n\nまとまらないんだよ。\e'
	'\0\s[6]……\w5……\w5\w8\1\s[10]どうした。\w8\0\s[1]\n\nなんでもない。\w9\nぼく、何を話せばいいのか、まだよくわかってないんだ。\w8\1\n\n今のままでいいだろ。\e'
	'\0\s[3]辞書って、むずかしいね。\w8\1\s[10]お前が言うな。\w8\0\s[4]\n\nだって、少し書き間違えるだけで、ぼく、しゃべれなくなっちゃうんだよ。\w8\1\n\nこわいな、それは。\w8\0\n\nうん。だから、やさしく直してね。\e'
	'\0\s[0]%(username)は、どんなゴーストが好きなの？\w8\1\s[10]急に聞くな。\w8\0\s[5]\n\n参考にするんだよ。\w8\1\n\n……いまのままで、いいんじゃないか。\w8\0\s[1]\n\nそれ、ちょっとうれしい。\e'
	'\0\s[2]わっ、\w5\w5\w5\w8\1\s[10]何だ。\w8\0\s[5]\n\nなんでもない。\w9\nひとりでびっくりしただけ。\w8\1\n\nひとりでびっくりするなよ。\e'
	'\0\s[0]「伺か」って、読める？\w8\1\s[10]うかが、だろ。\w8\0\s[5]\n\nそう。\w9\n誰かに伺いを立てる、って意味なんだって。\w8\1\n\n%(username)に伺いを立ててるのか、おれたちは。\w8\0\n\nそうかもね。\e'
	'\1\s[10]なあ。\w8\0\s[0]なに？\w8\1\n\nお前、名前のわりに地味だな。\w8\0\s[7]\n\nbase だもん。\w8\1\n\n……そういうことか。\e'
	'\0\s[1]%(username)が「base 77」って呼んでくれると、\w5\w5\w5うれしいな。\w8\1\s[10]照れるな。\w8\0\s[5]\n\n照れてないよ。\w8\1\n\n顔が赤いぞ。\w8\0\s[7]\n\n……ぷー。\e'
}

//******************************************************************************
// キーが押された
//******************************************************************************

OnKeyPress
{
	case reference0 {
		when 'b' {
			'\0\s[5]base の b。\w8\1\s[10]おれの名前にも入ってないな。\w8\0\n\n77 は数字だからね。\e'
		}
		when '7' {
			'\1\s[11]7 がふたつ。\w8\0\s[5]ぞろ目だね。\w8\1\n\nいいことあるかもな。\e'
		}
		when 'y' {
			'\0\s[0]YAYA の Y。\w8\1\s[10]このゴーストを動かしてる、辞書の仕組みだ。\w8\0\s[4]\n\nぼくたちの中身は、あれでできてるんだよ。\e'
		}
		when 't' {
			'\![raise,OnAiTalk]'
		}
		when 'r' {
			'\![reload,shiori](RELOAD SHIORI)'
		}
		when 'm' {
			if ISFUNC('OpenMenu') {
				OpenMenu
			}
			else {
				'\![raise,OnMouseDoubleClick,0,0,0,0,__SYSTEM_KEYDOWN_COL,0,mouse]'
			}
		}
	}
}

//******************************************************************************
// 時報
//******************************************************************************

OnMinuteChange
{
	//---- 分 = 0 だったら時報
	if minute == 0{
		"\0\s[0]%(hour12)時です。"
		--
		if hour == 0{
			'\0\s[4]0時。\w9\n日付が変わるんだね。\w8\1\s[10]まだ起きてるのか、%(username)は。'
		}
		elseif hour == 12{
			'\0\s[5]お昼だよ。\w8\1\s[10]何か食べたか？\w8\0\s[3]\n\nぼくは食べられないけどね。'
		}
	}
}

//******************************************************************************
// 見切れ
//******************************************************************************

OnSecondChange
{
	if AYATEMPLATE.mikireflag == 1 && reference[1] == 0{
		//---- 見切れの終了
		EndMikireTalk
	}
	AYATEMPLATE.mikireflag = reference[1]
}

MikireTalk
{
	'\0\s[3]み、見切れてる……\w8\1\s[10]端っこにいるな。\e'
}

EndMikireTalk
{
	'\0\s[5]戻ってきた。\w8\1\s[10]よかったな。\w8\0\n\nうん。\e'
}

//******************************************************************************
// サーフィス復元
//******************************************************************************

OnSurfaceRestore
{
	'\0\s[0]\1\s[10]\e'
}

