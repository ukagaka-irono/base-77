//******************************************************************************
// base 77  マウス入力関連辞書
//******************************************************************************
//
// 関数名は [種別] + [スコープ] + [部位] です。
// 種別は MouseMove, MouseDoubleClick, MouseWheelUp, MouseWheelDown。
// 部位は surfaces.txt の collision で付けた名前（Head, Face, Body）。
//

//******************************************************************************
// なで反応
//******************************************************************************
MouseMove0Head
{
	'\0\s[1]あ……\w5\w5\e'
	'\0\s[8]なでられるの、すき。\w8\1\s[10]単純だな。\w8\0\s[4]\n\nだって、うれしいんだもん。\e'
	'\0\s[0]そこ、髪のところ。\w8\1\s[10]髪かどうかも、まだ決まってないだろ。\w8\0\s[3]\n\n……そうだった。\e'
}

MouseMove0Face
{
	'\0\s[7]顔は、やさしくして。\w8\1\s[10]まだ何もされてないぞ。\w8\0\s[4]\n\n……ぷー。\e'
	'\0\s[1]%(username)の手、あったかいね。\w8\1\s[10]よく言うよ。\e'
}

MouseMove0Body
{
	'\0\s[2]うわっ。\w8\1\s[10]びっくりしすぎだ。\w8\0\s[1]\n\nだって、急に触るんだもん。\e'
	'\0\s[4]そこは、まだ中身が入ってないところ。\w8\1\n\nつまりすかすかってことか。\w8\0\s[7]\n\n違うってば。\e'
}

//******************************************************************************
// つつかれ反応
//******************************************************************************
MouseDoubleClick0Head
{
	'\0\s[2]いたっ。\w8\1\s[10]そこまで痛くないだろ。\w8\0\s[4]\n\nびっくりしたの。\e'
	'\0\s[3]つつくと、まだ何も出てこないよ。\w8\1\n\n中身が入ってないからな。\w8\0\s[7]\n\nそういうことじゃないの。\e'
}

MouseDoubleClick0Face
{
	'\0\s[7]つんつん、やめてってば。\w8\1\s[10]やめてやれよ、%(username)。\w8\0\s[1]\n\n……一回だけなら、いいけど。\e'
}

MouseDoubleClick0Body
{
	'\0\s[4]ここは、まだ空っぽなんだ。\w8\1\s[10]設定を入れるところだな。\w8\0\n\nうん。いつか、いっぱい入るといいね。\e'
}

MouseDoubleClick0
{
	//顔以外のつつきでメニュー展開
	OpenMenu
}

MouseDoubleClick1
{
	'\1\s[11]おい、そこは画面だ。\w8\0\s[0]七々は数字なのに、画面があるんだね。\w8\1\s[10]気にするな。\e'
	'\1\s[12]……くすぐったい。\w8\0\s[5]えへへ。\w8\1\n\n笑うな。\e'
}

//******************************************************************************
// マウス処理部コア
//******************************************************************************

OnMouseMove
{
	AYATEMPLATE.MouseMoveWheelFunc(0,50,'MouseMove')
}

OnMouseWheel
{
	_result = ''
	if TOINT(reference[2]) > 0 {
		_result = AYATEMPLATE.MouseMoveWheelFunc(1,4,'MouseWheelUp')
	}
	else {
		_result = AYATEMPLATE.MouseMoveWheelFunc(1,4,'MouseWheelDown')
	}

	if _result == '' {
		_result = AYATEMPLATE.MouseMoveWheelFunc(1,4,'MouseWheel')
	}

	_result
}

OnMouseDoubleClick
{
	AYATEMPLATE.MouseEventExec('MouseDoubleClick')
}
