//******************************************************************************
// base 77  コミュニケート辞書
//******************************************************************************

//******************************************************************************
// こちらから話しかける
//******************************************************************************

StartCommunicate
{
	AYATEMPLATE.ExecuteTalkToTalk
}

TalkToOther
{
	_escaped_name = SHIORI3FW.EscapeAllTags(res_reference0)
	'\0\s[0]こんにちは、%(_escaped_name)さん。\w8\1\s[10]元気そうだな。\e'
}

TalkToNobody
{
	'\0\s[4]だれもいないね。\w8\1\s[10]静かだ。\w8\0\n\nちょっと、さみしい。\e'
}

//******************************************************************************
// 話しかけられたので返事する
//******************************************************************************

OnCommunicate
{
	if reference[0] == "user" || reference[0] == "User"{
		//---- ユーザーからの話しかけ
		ReplyToUser
	}
	else{
		//---- ゴーストからの話しかけ
		AYATEMPLATE.ExecuteReplyToTalk(reference[0])
	}
}

//------------------------------------------------------------------------------
// ユーザーからの話しかけ
//------------------------------------------------------------------------------
ReplyToUser
{
	if "名前" _in_ reference[1] && "覚えて" _in_ reference[1]{
		//---- ユーザー名入力開始
		'\0\s[0]いいよ。なんていう名前なの？\e'
		teachusername = 1
	}
	else{
		if teachusername == 1{
			//---- 直前が「名前覚えて」だったので名前を覚える
			if SHIORI3FW.EscapeAllTags(reference[1]) != reference[1] {
				'\0\s[3]変な記号は、ちょっとこわいな。\e'
			}
			else {
				username = reference[1]
				'\0\s[5]%(username)、ね。\w9\nおぼえたよ。\e'
			}
			teachusername = 0
		}
		else{
			TalkToUser
		}
	}
}

//------------------------------------------------------------------------------
// ユーザーへの返事（名前覚え以外）
//------------------------------------------------------------------------------
TalkToUser
{
	if 'こんにちは' _in_ reference[1] || 'こんばんは' _in_ reference[1]{
		'\0\s[5]こんにちは。\w8\1\s[10]どうも。\e'
	}
	elseif "好き" _in_ reference[1] || "愛し" _in_ reference[1]{
		'\0\s[1]……\w5\w5ありがとう。\w8\1\s[16]照れてるな。\w8\0\s[7]\n\n照れてないよ。\e'
	}
	elseif "基" _in_ reference[1] || "七々" _in_ reference[1] || "base 77" _in_ reference[1]{
		'\0\s[0]ぼくが基で、\w5\1\s[10]わたしが七々。\w8\0\n\nふたりで、ひとつ。\e'
	}
	elseif "シェル" _in_ reference[1] || "見た目" _in_ reference[1]{
		'\0\s[4]見た目は、まだ仮なんだ。\w8\1\s[10]そのうち変わる。\w8\0\n\n楽しみにしててね。\e'
	}
	else{
		'\0\s[3]うーん……\w9\nうまく、聞きとれなかった。\w8\1\s[10]もう一回言ってやってくれ。\e'
	}
}

//------------------------------------------------------------------------------
// ゴーストからの話しかけ
//------------------------------------------------------------------------------
ReplyToOther
{
	if "こんにちは" _in_ reference[1] || "こんばんは" _in_ reference[1]{
		res_reference0 = reference[0]
		_escaped_name = SHIORI3FW.EscapeAllTags(res_reference0)
		'\0\s[5]こんにちは、%(_escaped_name)さん。\w8\1\s[10]よろしく。\e'
	}
	else{
		'\0\s[0]はい？\e'
	}
}
