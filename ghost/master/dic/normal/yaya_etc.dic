//******************************************************************************
// base 77  種々のイベント辞書
//******************************************************************************

//******************************************************************************
// シェル切り替え
//******************************************************************************

OnShellChanging
{
	'\0\s[1]着替えるんだね。\w8\1\s[10]まだ仮の姿だけどな。\e'
}

OnShellChanged
{
	_escaped_name = SHIORI3FW.EscapeAllTags(reference[0])
	'\0\s[2]わ、変わった。\w9\n「%(_escaped_name)」だって。\w8\1\s[10]似合ってるんじゃないか。\w8\0\s[5]\n\nうん。\e'
}

//******************************************************************************
// インストール関連
//******************************************************************************

OnInstallBegin
{
	'\0\s[0]インストール中……\w8\1\s[10]待ってろ。\e'
}

OnInstallComplete
{
	_ref0 = SPLIT(reference[0],' with',2)[0]

	'\0\s[5]'
	--
	if _ref0 == 'shell' {
		'シェル'
	}
	elseif _ref0 == 'ghost' {
		'ゴースト'
	}
	elseif _ref0 == 'balloon' {
		'バルーン'
	}
	elseif _ref0 == 'plugin' {
		'プラグイン'
	}
	--
	_escaped_name = SHIORI3FW.EscapeAllTags(reference[1])
	"「%(_escaped_name)」、インストールできたよ。\n"
	--
	if basewarenameex == 'SSP' {
		_id = ''
		if _ref0 == 'shell' {
			_id = 'shell'
		}
		elseif _ref0 == 'ghost' {
			_id = 'ghost'
		}
		elseif _ref0 == 'balloon' {
			_id = 'balloon'
		}

		if _id != '' {
			'切り替える？'
			--
			AYATEMPLATE.MenuItem("切り替える","OnAYATEMPLATE.InstallChange",_id,200)
			--
			AYATEMPLATE.MenuItem("切り替えない","Menu_CANCEL")
		}
	}
}

OnAYATEMPLATE.InstallChange
{
	"\![change,%(AYATEMPLATE.EscapeText(reference[0])),lastinstalled]"
}

OnInstallFailure
{
	_escaped_message = SHIORI3FW.EscapeAllTags(reference[0])
	'\0\s[3]インストール、失敗しちゃった。\w9\n理由：%(_escaped_message)\w8\1\s[10]また今度だな。\e'
}

OnInstallRefuse
{
	_escaped_name = SHIORI3FW.EscapeAllTags(reference[0])
	'\0\s[4]これ、%(_escaped_name)さん用のアーカイブみたい。\w8\1\s[10]渡してやれ。\e'
}

//******************************************************************************
// 消滅関連
//******************************************************************************

OnVanishSelecting
{
	'\0\s[3]消えちゃうの？\w8\1\s[10]まだ早いだろ。\e'
}

OnVanishSelected
{
	'\0\s[4]……\w5\w5\w5さようなら。\w8\1\s[10]また、どこかで。\e'
}

OnVanishCancel
{
	'\0\s[5]よかった。\w8\1\s[10]消さなくて、正解だ。\w8\0\s[1]\n\nうん。\e'
}

OnVanished
{
	_escaped_name = SHIORI3FW.EscapeAllTags(reference[0])
	'\0\s[3]%(_escaped_name)さん、いなくなっちゃった。\w8\1\s[10]そういうこともある。\w8\0\s[4]\n\nさみしいね。\e'
}

//******************************************************************************
// メールチェック
//******************************************************************************

OnBIFFBegin
{
	'\0\s[0]メール、見てくるね。\w8\1\s[10]頼んだ。\e'
}

OnBIFFComplete
{
	if TOINT(reference[0]) == 0{
		'\1\s[10]メールは来てないな。\w8\0\s[1]\n\nそっか。\e'
	}
	else{
		'\1\s[10]%(reference[0])通、来てるぞ。\w8\0\s[5]\n\n%(username)、見てみたら？\e'
	}
}

OnBIFFFailure
{
	if reference[0] == 'timeout'{
		'\1\s[10]サーバに繋がらない。\w8\0\s[4]\n\n時間切れ、だね。\e'
	}
	elseif reference[0] == 'kick'{
		'\1\s[10]蹴られた。\w8\0\s[3]\n\nなんでだろう。\e'
	}
	elseif reference[0] == 'defect'{
		'\0\s[4]メールチェックの設定を、見なおしてね。\w8\1\s[10]そういうことだ。\e'
	}
	else{
		'\1\s[10]原因はわからないが、失敗だ。\w8\0\s[3]\n\n……うーん。\e'
	}
}

//******************************************************************************
// ネットワーク更新
//******************************************************************************

OnUpdateBegin
{
	'\0\s[5]更新、はじめるよ。\w8\1\s[10]どこまで変わるかな。\e'
}

OnUpdateReady
{
	'\0\s[0]%(TOINT(reference[0])+1)個のファイルを、持ってくるね。\w8\1\s[10]よし。\e'
}

OnUpdateComplete
{
	if reference[0] == 'none'{
		'\1\s[10]更新するファイルは無かった。\w8\0\s[4]\n\nそっか。\w8\1\n\n今のままでいいってことだ。\e'
	}
	else{
		'\0\s[5]更新、完了。\w8\1\s[10]おつかれさん。\w8\0\s[1]\n\n少し、変わったかな。\e'
	}
}

OnUpdateFailure
{
	if reference[0] == 'timeout'{
		'\0\s[3]時間切れ……\w8\1\s[10]また今度だ。\e'
	}
	elseif reference[0] == 'md5 miss'
	{
		'\0\s[3]ファイルが、なんか違うみたい。\w8\1\s[10]壊れてるな。\e'
	}
	else{
		'\0\s[4]更新、失敗しちゃった。\w8\1\s[10]理由は……\w5\w5まあいい。\e'
	}
}

OnUpdate.OnDownloadBegin
{
	_escaped_name = SHIORI3FW.EscapeAllTags(reference[0])
	'\0\s[0]「%(_escaped_name)」をダウンロード中。\e'
}

OnUpdate.OnMD5CompareBegin
{
	'\0\s[0]ファイルを確認中。\w8\1\s[10]ちゃんと合ってるか見ろよ。\e'
}

OnUpdate.OnMD5CompareComplete
{
	'\0\s[5]オッケー。\w8\1\s[10]よかった。\e'
}

OnUpdate.OnMD5CompareFailure
{
	'\0\s[3]合ってないみたい。\w8\1\s[10]やり直しだ。\e'
}

//******************************************************************************
// ヘッドラインセンス
//******************************************************************************

OnHeadlinesenseBegin
{
	_escaped_name = SHIORI3FW.EscapeAllTags(reference[0])
	'\0\s[0]%(_escaped_name)のヘッドライン、取ってくるね。\e'
}

OnHeadlinesense.OnFind
{
	_escaped_name = SHIORI3FW.EscapeAllTags(reference[0])
	if reference[2] == "First" || reference[2] == "First and Last"{
		'\0\b2\s[0]%(_escaped_name)のヘッドラインだよ。'
	}
	elseif reference[2] == 'Next'{
		'\0\b2\s[0]%(_escaped_name)、続き。'
	}
	elseif reference[2] == 'Last'{
		'\0\b2\s[0]%(_escaped_name)、さいごのページ。'
	}
	--
	"\n\n%(reference[3])\n"
	--
	if reference[2] == "First" || reference[2] == "Next"{
		AYATEMPLATE.MenuItem("次のページ","")
		--
		AYATEMPLATE.MenuItem('サイトへ',reference[1])
		--
		AYATEMPLATE.MenuItem("やめ","Menu_HEADLINECANCEL",150)
	}
	else{
		AYATEMPLATE.MenuItem('サイトへ',reference[1])
		--
		AYATEMPLATE.MenuItem("やめ","Menu_HEADLINECANCEL",150)
	}
}

OnHeadlinesenseComplete
{
	_escaped_name = SHIORI3FW.EscapeAllTags(reference[0])
	'\0\s[0]%(_escaped_name)、新しいのは無いみたい。\e'
}

OnHeadlinesenseFailure
{
	'\0\s[3]ヘッドライン、取れなかった。\n\n理由：'
	--
	if reference[0] == "can't download"{
		'ダウンロード失敗。'
	}
	elseif reference[0] == "can't analyze"{
		'解析失敗。'
	}
	else{
		'わからない。'
	}
	--
	'\e'
}

//******************************************************************************
// ファイル作成関連
//******************************************************************************

OnUpdatedataCreating
{
	'\0\s[0]アップデートデータを作ってる。\w8\1\s[10]できるのか。\e'
}

OnUpdatedataCreated
{
	'\0\s[5]できたよ。\w8\1\s[10]よし。\e'
}

OnNarCreating
{
	'\0\s[5]nar ファイルを作るね。\w8\1\s[10]待ってる。\e'
}

OnNarCreated
{
	"\0\s[5]「%(SHIORI3FW.EscapeAllTags(reference[0]))」のnar、「%(SHIORI3FW.EscapeAllTags(reference[1]))」、できたよ。\w8\1\s[10]おつかれ。\e"
}

//******************************************************************************
// 時計合わせ
//******************************************************************************

OnSNTPBegin
{
	"\0\s[0]時計、合わせるね。\w8\1\s[10]%(SHIORI3FW.EscapeAllTags(reference[0]))に繋ぐぞ。\e"
}

SNTPCompare_StrForm
{
	_txt = SPLIT(_argv[0],',')
	STRFORM('$04d/$02d/$02d $02d:$02d:$02d',TOINT(_txt[0]),TOINT(_txt[1]),TOINT(_txt[2]),TOINT(_txt[3]),TOINT(_txt[4]),TOINT(_txt[5]))
}

OnSNTPCompare
{
	"\0\s[0]\_q/
	修正前 %(SNTPCompare_StrForm(reference[2]))\n/
	修正後 %(SNTPCompare_StrForm(reference[1]))\n/
	\_q\n"
	--
	if reference[3] == 0{
		'ぴったりだった。\e'
	}
	else{
		//\6は補正実行タグ。消しちゃだめ
		"\6\0\n\s[5]%(SHIORI3FW.EscapeAllTags(reference[3]))秒、ずれてた。"
	}
}

OnSNTPFailure
{
	'\0\s[3]時計合わせ、失敗。\w8\1\s[10]そういう日もある。\e'
}

//******************************************************************************
// そのほか
//******************************************************************************

OnDisplayChange
{
	//---- ディスプレイ解像度と色深度を保持
	displaybpp    = reference[0]
	displaywidth  = reference[1]
	displayheight = reference[2]
	SHIORI3FW.RegisterTempVar('displaybpp', 'displaywidth', 'displayheight')
}

OnURLDropping
{
	"\0\s[0]%(SHIORI3FW.EscapeAllTags(reference[0]))から、データを取ってるよ。\e"
}

OnEmbryoExist
{
	'\0\s[0]「伺か」が起動してるね。\w8\1\s[10]にぎやかになりそうだ。\e'
}

OnNekodorifExist
{
	'\0\s[2]猫どりふだ。\w8\1\s[10]まだ動いてたのか。\e'
}

OnScreenSaverStart
{
	'\0\s[5]画面、休ませてあげよう。\e'
}

OnScreenSaverEnd
{
	'\0\s[5]おかえり。\w8\1\s[10]戻ったな。\e'
}
