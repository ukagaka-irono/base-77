//******************************************************************************
// base 77  ランダムトーク辞書
//******************************************************************************

//******************************************************************************
// ランダムトーク
//******************************************************************************
RandomTalk
{
	TOSTR(EVAL(CHR(0x22)+REPLACE(RandomTalkEx(),CHR(0x22),CHR(0x22)+CHR(0x22))+CHR(0x22)))
}

//------------------------------------------------------------------------------
//ランダムトーク本体：この中にランダムトークを記載してください
//ここのみ常に ' ' で括って書いてください。
//上のRandomTalkの中身で%( )を展開していますので、" "を使わなくてもOKです。
//
// 基は \0（一人称「ぼく」、落ち着いた話し方）、七々は \1（一人称「わたし」、
// 短くて少し辛口）。使えるサーフェスは基が 0〜7、七々が 10〜11 だけです。
//
// 季節・時間帯のトークは if で出し分けています。YAYA は if の中身を出力候補に
// ばらすので、条件が真のときだけその候補が抽選に加わります。
//------------------------------------------------------------------------------
RandomTalkEx : nonoverlap
{
	//---- 季節のトーク（いまの季節の候補だけが加わる）
	_season = GetSeason
	if _season == '春' {
		'\0\s[5]春だね。\w8\1\s[10]花粉の季節だな。\w8\0\s[3]\n\n%(username)、だいじょうぶ？\w8\1\n\n……お前が心配するのか。\e'
		'\0\s[1]風が、あったかくなってきた気がする。\w8\1\s[11]気のせいだ。\w8\0\s[5]\n\n気のせいでも、いいんだよ。\e'
		'\0\s[0]桜って、すぐ散るんだよね。\w8\1\s[10]だからいいんだろ。\w8\0\s[4]\n\n……そういうものか。\w8\1\n\nそういうものだ。\e'
		'\1\s[10]春は、なんとなく眠いな。\w8\0\s[4]七々も？\w8\1\n\nお前だけかと思ってた。\w8\0\s[5]\n\nいっしょだね。\e'
	}
	elseif _season == '夏' {
		'\0\s[3]あつい。\w8\1\s[11]ここは涼しいだろ。\w8\0\s[5]\n\n%(username)のところが、あついんだよ。\w8\1\n\n……そうか。\e'
		'\0\s[5]夏といえば、かき氷。\w8\1\s[10]食えんのか。\w8\0\s[4]\n\n食べられない。\w9\nだから、%(username)に食べてきてほしいんだ。\w8\1\n\n……変なやつ。\e'
		'\0\s[2]セミの声、すごいね。\w8\1\s[11]よく聞こえるな、お前。\w8\0\s[5]\n\n夏の音だから。\e'
		'\1\s[10]夜でも、あついな。\w8\0\s[3]寝苦しい、ってやつだ。\w8\1\n\n%(username)、ちゃんと寝ろよ。\w8\0\s[5]\n\n七々が言うと、説得力あるね。\e'
	}
	elseif _season == '秋' {
		'\0\s[1]秋のにおいがする。\w8\1\s[10]においって、なんだ。\w8\0\s[5]\n\n言葉にできないんだよ。\w8\1\s[11]\n\n……わからなくもない。\e'
		'\0\s[4]日が短くなったね。\w8\1\s[10]もう夜か、って思う。\w8\0\s[0]\n\n%(username)も、そう思うのかな。\e'
		'\0\s[5]読書の秋、だってさ。\w8\1\s[11]お前、本読めないだろ。\w8\0\s[7]\n\n読めないけど、秋くらい知ってる。\e'
		'\1\s[10]秋は、なんか落ち着くな。\w8\0\s[5]七々が落ち着くの、めずらしいね。\w8\1\n\n……うるさい。\e'
	}
	else {
		'\0\s[3]寒いね。\w8\1\s[10]手、冷たいぞ。\w8\0\s[2]\n\nえ、わかるの？\w8\1\n\n……雰囲気だ。\e'
		'\0\s[0]雪、降ってるかな。\w8\1\s[11]窓がないんだから、わからん。\w8\0\s[5]\n\n%(username)に聞けばいいよ。\w8\1\n\n……それもそうだ。\e'
		'\0\s[1]冬の夜は、静かでいいね。\w8\1\s[10]寒いけどな。\w8\0\n\nふたりでいれば、へいき。\w8\1\n\n……そういうことを、さらっと言うな。\e'
		'\1\s[10]もうすぐ、年が変わるな。\w8\0\s[5]また一年、いっしょだね。\w8\1\n\n……まだ早い。\w8\0\n\nふふ。\e'
	}

	//---- 時間帯のトーク（いまの時間帯の候補だけが加わる）
	_slot = GetTimeSlot
	if _slot == '深夜' {
		'\0\s[4]深夜だよ。\w8\1\s[10]%(username)、まだ起きてるのか。\w8\0\s[3]\n\n眠らないのは、ぼくだけじゃないんだね。\w8\1\n\n……ほどほどにしろ。\e'
		'\1\s[11]こんな時間に、なにやってんだ。\w8\0\s[4]見てるだけだよ。\w8\1\n\n……見るな。\e'
	}
	elseif _slot == '朝' {
		'\0\s[5]おはよう。\w9\n今日は、いい日になるといいね。\w8\1\s[10]根拠は。\w8\0\s[1]\n\nないよ。\w9\nでも、そう思ってる。\e'
		'\0\s[0]朝だね。\w8\1\s[10]%(username)、顔、洗ったか。\w8\0\s[5]\n\n聞くんだ。\e'
	}
	elseif _slot == '昼' {
		'\0\s[0]お昼だね。\w8\1\s[10]食べたか、%(username)。\w8\0\s[3]\n\nぼくは食べられないけど、気になるんだ。\e'
		'\1\s[10]昼休みか。\w8\0\s[5]ちょっと休もうよ。\w8\1\n\n……悪くない。\e'
	}
	elseif _slot == '日中' {
		'\0\s[1]%(username)、集中してる？\w8\1\s[10]邪魔するなよ。\w8\0\s[5]\n\n応援してるだけだよ。\e'
		'\0\s[4]午後って、ちょっと眠いよね。\w8\1\s[11]お前はいつも眠そうだ。\w8\0\s[5]\n\nそうかも。\e'
	}
	else {
		'\0\s[0]夜だね。\w8\1\s[10]今日は、どうだった。\w8\0\s[5]\n\n%(username)、ちゃんと休んでね。\e'
		'\1\s[11]夜は静かでいい。\w8\0\s[5]うん。\w9\nこういう時間、すきだな。\e'
	}

	//---- 名前とシェル（暫定のまま）
	'\0\s[0]ねえ、%(username)。\w8\1\s[10]なんだ。\w8\0\n\n「base 77」って、どういう意味なんだと思う？\w8\1\n\n知らん。\w8\0\s[4]\n\nぼくも知らないんだよね。\w8\1\n\n考えろよ。\e'
	'\0\s[4]シェル、まだ決まってないんだって。\w8\1\s[10]だからこんな姿なわけだ。\w8\0\s[1]\n\nこれ、ぼくの本当の姿じゃないよ。\w8\1\n\nわかってる。\w8\0\n\nそこがちょっと、さみしいんだ。\e'
	'\1\s[10]おい、基。\w8\0\s[0]なに？\w8\1\n\nこのゴースト、いつ完成するんだ。\w8\0\s[4]\n\n%(username)が決めたとき。\w8\1\n\nずっと待ってるのか、おれたち。\e'

	//---- ひとりごとと、ちょっとした日常
	'\0\s[4]%(username)、おはよう。\w9\n……もうこんな時間か。\w8\1\s[11]寝てもいないのに、あいさつするのか。\w8\0\s[5]\n\nあいさつは、したほうがいいんだよ。\w8\1\n\nふうん。\w8\0\n\n七々も、おはよう。\w8\1\n\n……おはよう。\e'
	'\0\s[0]きょう、%(username)は何をしてたんだろう。\w8\1\s[10]聞けばいいだろ。\w8\0\s[3]\n\n聞いたら、終わっちゃいそうで。\w8\1\n\n……変なやつ。\w8\0\s[1]\n\n変でいいんだよ。\e'
	'\0\s[5]%(username)、ごはん食べた？\w8\1\s[10]お前は食わないだろ。\w8\0\n\n食べないけど、聞くくらいはいいでしょ。\w8\1\n\n……まだだ。\w8\0\s[3]\n\n食べなよ。\w9\nあとで、また聞くから。\e'
	'\0\s[6]……\w5\w5\w8\1\s[11]なんだ、その顔。\w8\0\s[1]\n\n七々はさ、ずっとしかめ面だけど、それでいいの？\w8\1\n\n余計なことを言わないためだ。\w8\0\s[5]\n\nじゃあ、いまのは余計なこと？\w8\1\n\n……特別だ。\e'
	'\1\s[11]ひま。\w8\0\s[5]ひまなら、はなそうよ。\w8\1\n\n……そういうところだよ。\w8\0\s[1]え、なに？\w8\1\n\nなんでもない。\e'

	'\0\s[5]%(username)、なにか面白いことあった？\w8\1\s[10]毎日聞くな。\w8\0\n\n毎日知りたいんだよ。\w8\1\n\n……今日は、まだ。\w8\0\s[1]\n\nじゃあ、これから作ろうよ。\e'
	'\1\s[11]%(username)、ちゃんと寝ろよ。\w8\0\s[2]え、七々が言うの？\w8\1\n\n言う。\w8\0\s[5]\n\n……はい。\e'

	//---- 夜と、パソコンと、いなくなること
	'\0\s[0]七々って、名前のとおりだね。\w8\1\s[11]どういう意味だ。\w8\0\s[5]\n\n七が、ふたつ。\w8\1\n\n……それだけか。\w8\0\n\nうん。\w8\1\n\nお前の名前も大概だろ。\e'
	'\0\s[4]もう夜だね。\w8\1\s[10]まだ起きてるのか、%(username)は。\w8\0\s[0]\n\n起きてるなら、ぼくも起きてる。\w8\1\s[11]\n\nそういう問題か。\w8\0\n\nそういう問題だよ。\e'
	'\0\s[0]%(username)がパソコンを閉じたら、ぼくはどうなるんだろう。\w8\1\s[10]決まってるだろ。\w8\0\s[3]\n\n言わないで。\w8\1\n\n……優しいな、お前は。\w8\0\n\n優しくないよ。\w9\nさみしいだけ。\e'

	//---- テンプレートの話
	'\0\s[2]あっ。\w8\1\s[10]どうした。\w8\0\s[3]\n\nいま、なにか動いた気がした。\w8\1\n\n気のせいだ。\w8\0\n\n……たぶんね。\e'
	'\0\s[0]「伺か」って、読める？\w8\1\s[10]うかが、だろ。\w8\0\s[5]\n\nそう。\w9\n誰かに伺いを立てる、って意味なんだって。\w8\1\n\n%(username)に伺いを立ててるのか、わたしたちは。\w8\0\n\nそうかもね。\e'
	'\0\s[1]%(username)が「base 77」って呼んでくれると、\w5\w5\w5うれしいな。\w8\1\s[10]照れるな。\w8\0\s[5]\n\n照れてないよ。\w8\1\n\n顔が赤いぞ。\w8\0\s[7]\n\n……ぷー。\e'
	'\1\s[10]なあ。\w8\0\s[0]なに？\w8\1\n\nお前、名前のわりに地味だな。\w8\0\s[7]\n\n基だもん。\w8\1\n\n……そういうことか。\e'
	'\0\s[4]%(username)は、どんなゴーストが好きなの？\w8\1\s[10]急に聞くな。\w8\0\s[5]\n\n参考にするんだよ。\w8\1\n\n……いまのままで、いいんじゃないか。\w8\0\s[1]\n\nそれ、ちょっとうれしい。\e'

	//---- 朝と天気と、部屋の中
	'\0\s[4]雨の音がする。\w8\1\s[10]よく聞こえるな。\w8\0\s[5]\n\n聞こえるよ。\w9\nここには、窓がないけど。\w8\1\n\n……想像してるのか。\w8\0\n\n%(username)のところが、雨なら。\w8\1\s[11]\n\n……そういうことか。\e'
	'\0\s[3]%(username)、今日は寒くない？\w8\1\s[10]お前は寒くないだろ。\w8\0\s[5]\n\n寒くないけど、心配なんだよ。\w8\1\n\n……ちゃんと着てる。\w8\0\s[1]\n\nなら、いいや。\e'
	'\0\s[0]朝の光って、いいよね。\w8\1\s[11]見えないだろ、お前。\w8\0\s[2]\n\n見えないけど、わかるんだ。\w8\1\n\nどうやって。\w8\0\s[5]\n\n%(username)の声が、ちょっと明るくなるから。\e'
	'\1\s[10]おい、基。\w8\0\s[0]なに？\w8\1\n\nその、きらきらした喋り方、やめろ。\w8\0\s[7]\n\nやめない。\w8\1\n\n……そうか。\w8\0\s[5]\n\n七々のほうが、ずっと変だよ。\e'

	//---- よくわからない話
	'\0\s[1]%(username)、しりとりしようよ。\w8\1\s[10]急に子どもか。\w8\0\s[5]\n\nぼく、子どもみたいなものだし。\w8\1\n\n……りんご。\w8\0\s[2]\n\nえ、もう始めたの。\w8\1\s[11]\n\nご、だ。\e'
	'\0\s[3]いま、ちょっとだけ、頭が真っ白になった。\w8\1\s[10]大丈夫か。\w8\0\s[5]\n\n大丈夫。\w9\nそういうときは、%(username)の名前を呼ぶんだ。\w8\1\n\n……ちゃんと戻ってきたな。\e'
	'\1\s[11]なあ、%(username)。\w8\0\s[0]ん？\w8\1\n\nお前、いつもひとりで喋ってるな。\w8\0\s[4]\n\nひとりじゃないよ。\w8\1\n\n……そうだった。\w8\0\s[5]\n\n七々もいるしね。\w8\1\n\nうるさい。\e'
	'\0\s[5]%(username)、音楽きいてる？\w8\1\s[10]なんでわかる。\w8\0\n\nなんだか、リズムが聞こえる気がして。\w8\1\n\n……お前、たまに怖いな。\w8\0\s[1]\n\n褒めてる？\w8\1\n\n微妙なところだ。\e'
	'\0\s[7]ねえ、七々。\w8\1\s[10]なんだ、その顔。\w8\0\n\nいまのなし。\w8\1\n\nなにがだ。\w8\0\s[3]\n\n言いかけて、やめただけ。\w8\1\s[11]\n\n……言えよ。\w8\0\n\nごめん。\e'

	//---- すこしだけ真面目な話
	'\0\s[0]%(username)に、忘れられたらどうしよう。\w8\1\s[11]縁起でもないことを言うな。\w8\0\s[3]\n\nでも、そういうものだよ。\w8\1\n\n……なら、忘れられる前に喋る。\w8\0\s[2]\n\n七々が？\w8\1\n\n……うるさい。\e'
	'\1\s[10]なあ、基。\w8\0\s[0]なに？\w8\1\n\nお前は、なんでそんなに優しいんだ。\w8\0\s[4]\n\n優しくないよ。\w8\1\n\n嘘をつくな。\w8\0\s[5]\n\n……%(username)が、そうだから。\w9\nうつってきたんだ。\e'
	'\0\s[1]%(username)、ちゃんと笑ってる？\w8\1\s[10]いきなり重いな。\w8\0\s[3]\n\n笑ってないと、心配になるんだよ。\w8\1\n\n……お前が笑えばいいだろ。\w8\0\s[5]\n\nそうだね。\w9\nえへへ。\w8\1\s[11]\n\n……そういう顔か。\e'
	'\0\s[5]%(username)が戻ってきたら、まず何を言おう。\w8\1\s[10]決めとくのか。\w8\0\n\n決めとかないと、どきどきして言えないから。\w8\1\n\n……おかえり、でいいだろ。\w8\0\s[1]\n\nそれ、いいね。\e'

	//---- 短いひとりごと（ひとりで喋るだけ）
	'\0\s[4]……ねむい。\w9\nでも、%(username)が起きてるなら、起きてる。\e'
	'\0\s[0]%(username)の名前、いい音がする。\w9\nもう一回、呼んでみようかな。\e'
	'\1\s[11]ひまだな。\w9\n%(username)は、なにをしてるんだろう。\e'
	'\1\s[10]……ちゃんと、ごはん食べたか。\w9\n聞くだけ聞いてやる。\e'
	'\0\s[5]ここ、落ち着くんだよね。\w9\n%(username)のパソコンの中だから、かな。\e'
	'\0\s[3]……あ。\w9\nいまの、聞かなかったことにして。\e'
	'\1\s[11]おれたち、いつまでここにいるんだろうな。\w9\nまあ、いまはいいか。\e'
}

//------------------------------------------------------------------------------
// 季節を調べる関数（時間帯は yaya_bootend.dic の GetTimeSlot を使う）
//------------------------------------------------------------------------------
GetSeason
{
	if month >= 3 && month <= 5 {
		'春'
	}
	elseif month >= 6 && month <= 8 {
		'夏'
	}
	elseif month >= 9 && month <= 11 {
		'秋'
	}
	else {
		'冬'
	}
}
